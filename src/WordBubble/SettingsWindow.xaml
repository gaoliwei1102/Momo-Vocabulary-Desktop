<Window x:Class="WordBubble.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="浮词 · 设置" Width="440" Height="590" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Icon="Assets/app.ico" Topmost="True">
  <Grid Margin="26,22">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="按你的节奏" FontSize="24" FontWeight="SemiBold" />
      <TextBlock Text="只在你需要时，留一点空间给单词。" Foreground="{StaticResource MutedInk}" Margin="0,7,0,22" />
    </StackPanel>
    <StackPanel Grid.Row="1">
      <CheckBox x:Name="KeepTopmost" Content="学习卡片保持置顶" Margin="0,0,0,14" />
      <CheckBox x:Name="HideFullscreen" Content="前台应用全屏时自动收起" Margin="0,0,0,20" />
      <TextBlock Text="气泡不透明度" Margin="0,0,0,8" />
      <Grid Margin="0,0,0,22"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="50" /></Grid.ColumnDefinitions>
        <Slider x:Name="OpacitySlider" Minimum="45" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center" AutomationProperties.Name="气泡不透明度" />
        <TextBlock Grid.Column="1" Text="{Binding ElementName=OpacitySlider, Path=Value, StringFormat={}{0:0}%}" HorizontalAlignment="Right" VerticalAlignment="Center" />
      </Grid>
      <TextBlock Text="展开 / 收起快捷键" Margin="0,0,0,10" />
      <StackPanel Orientation="Horizontal">
        <CheckBox x:Name="CtrlKey" Content="Ctrl" VerticalAlignment="Center" Margin="0,0,14,0" />
        <CheckBox x:Name="AltKey" Content="Alt" VerticalAlignment="Center" Margin="0,0,14,0" />
        <CheckBox x:Name="ShiftKey" Content="Shift" VerticalAlignment="Center" Margin="0,0,16,0" />
        <ComboBox x:Name="LetterKey" Width="58" Padding="5" AutomationProperties.Name="快捷键字母" />
      </StackPanel>
      <TextBlock Text="至少选择 Ctrl 或 Alt，避免影响日常打字。" FontSize="11" Foreground="{StaticResource MutedInk}" Margin="0,8,0,0" />
      <TextBlock x:Name="ErrorText" Foreground="#A44432" TextWrapping="Wrap" Margin="0,10,0,8" MinHeight="30" />
      <Button Content="把窗口移回当前屏幕" HorizontalAlignment="Left" Click="ResetPosition" />
      <Border BorderBrush="#DCE3DA" BorderThickness="0,1,0,0" Margin="0,22,0,0" Padding="0,14,0,0">
        <StackPanel>
          <TextBlock Text="浮词 0.3.4 · 你的桌边学习空间" FontSize="12" />
          <TextBlock Text="独立设计的桌面背词界面，学习记录连接墨墨账号。非墨墨官方客户端。" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource MutedInk}" Margin="0,6,0,0" />
        </StackPanel>
      </Border>
    </StackPanel>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="取消" Click="Cancel" Margin="0,0,8,0" />
      <Button Content="保存设置" Style="{StaticResource PrimaryButton}" Click="Save" />
    </StackPanel>
  </Grid>
</Window>
