<Window x:Class="WordBubble.LearningWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:WordBubble"
  Title="浮词 · 你的桌边学习空间" Width="420" Height="600" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" Topmost="True">
  <Window.Resources>
    <Style x:Key="Field" TargetType="TextBox"><Setter Property="FontSize" Value="15" /><Setter Property="Foreground" Value="#2E4237" /><Setter Property="Background" Value="#F1F2E9" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Padding" Value="13,12" /><Setter Property="VerticalContentAlignment" Value="Center" /><Setter Property="SelectionBrush" Value="#A4BC8D" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="Frame" Background="{TemplateBinding Background}" CornerRadius="12" BorderThickness="1" BorderBrush="#E1E6D8"><ScrollViewer x:Name="PART_ContentHost" /></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#668453" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style x:Key="Mode" TargetType="RadioButton"><Setter Property="Cursor" Value="Hand" /><Setter Property="Foreground" Value="#485A41" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="Surface" Padding="7,13" CornerRadius="13" BorderBrush="#E0E6D7" BorderThickness="1" Background="#F5F5EB"><ContentPresenter HorizontalAlignment="Center" /></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Surface" Property="Background" Value="#E5EEDB" /><Setter TargetName="Surface" Property="BorderBrush" Value="#829D6D" /></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#314A35" /></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.85" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  </Window.Resources>
  <Border x:Name="Card" Margin="12" CornerRadius="26" BorderBrush="#E0E5D7" BorderThickness="1" Background="#FFFCF5">
    <Border.RenderTransform><TranslateTransform x:Name="CardMotion" /></Border.RenderTransform>
    <Border.Effect><DropShadowEffect Color="#273D2B" Opacity="0.16" BlurRadius="19" ShadowDepth="4" /></Border.Effect>
    <Grid Margin="22,14,22,18">
      <Grid.RowDefinitions><RowDefinition Height="49" /><RowDefinition Height="*" /><RowDefinition Height="27" /></Grid.RowDefinitions>
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><local:SpriteControl Width="30" Height="32" Margin="-3,0,7,0" /><StackPanel><TextBlock Text="浮词" FontSize="16" FontWeight="SemiBold" Foreground="#2E4334" /><TextBlock x:Name="HeaderCaption" Text="你的桌边学习空间" FontSize="10" Foreground="#737C69" Margin="0,2,0,0" /></StackPanel></StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="GoHomeButton" Style="{StaticResource IconButton}" Content="&#xE80F;" Width="30" Click="GoHome" ToolTip="学习首页" AutomationProperties.Name="学习首页" />
          <Button Style="{StaticResource IconButton}" Content="&#xE77B;" Width="30" Click="OpenAccount" ToolTip="账号连接" AutomationProperties.Name="墨墨账号连接" />
          <Button Style="{StaticResource IconButton}" Content="&#xE713;" Width="30" Click="OpenSettings" ToolTip="偏好设置" AutomationProperties.Name="偏好设置" />
          <Button Style="{StaticResource IconButton}" Content="&#xE921;" Width="30" Click="Collapse" ToolTip="收起 · Esc" AutomationProperties.Name="收起为小精灵" />
        </StackPanel>
      </Grid>
      <Grid Grid.Row="1" Margin="0,14,0,0">
        <ScrollViewer x:Name="LoginPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
            <Border Background="#EDF2E1" CornerRadius="12" Padding="11,6" HorizontalAlignment="Left"><TextBlock Text="一个账号，继续原来的积累" Foreground="#60764D" FontSize="11" /></Border>
            <TextBlock Text="把单词，带到桌边。" Foreground="#2E4334" FontSize="27" FontWeight="SemiBold" Margin="0,18,0,10" />
            <TextBlock Text="连接你的墨墨账号，让小精灵陪你&#x0a;利用每一个刚刚好的空隙。" Foreground="#737C69" FontSize="13" LineHeight="23" />
            <TextBlock Text="手机号 / 邮箱" Foreground="#526348" FontSize="12" Margin="0,28,0,8" />
            <TextBox x:Name="AccountInput" Style="{StaticResource Field}" MaxLength="254" AutomationProperties.Name="墨墨手机号或邮箱" />
            <Grid Margin="0,18,0,8"><TextBlock Text="墨墨密码" Foreground="#526348" FontSize="12" /><Button Content="忘记密码？" HorizontalAlignment="Right" Background="Transparent" Padding="0" FontSize="11" Foreground="#6D7F5B" Click="AccountHelp" /></Grid>
            <Border Background="#F1F2E9" BorderBrush="#E1E6D8" BorderThickness="1" CornerRadius="12"><PasswordBox x:Name="PasswordInput" MaxLength="256" FontSize="15" Padding="13,12" Background="Transparent" BorderThickness="0" Foreground="#2E4237" AutomationProperties.Name="墨墨密码" /></Border>
            <TextBlock x:Name="LoginError" Foreground="#986148" TextWrapping="Wrap" FontSize="11" LineHeight="18" MinHeight="34" Margin="1,10,1,9" />
            <Button x:Name="LoginButton" Content="连接，开始积累  →" Height="46" Background="#405F43" Foreground="#FFFEF7" Click="Login" />
            <TextBlock Text="密码仅用于本次墨墨登录，不保存。&#x0a;本工具独立设计，非墨墨官方客户端。" TextAlignment="Center" Foreground="#737C69" FontSize="10" LineHeight="19" Margin="0,16,0,0" />
          </StackPanel>
        </ScrollViewer>
        <ScrollViewer x:Name="HomePage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
            <Border Background="#3F5B43" CornerRadius="20" Height="149">
              <Grid ClipToBounds="True"><Grid.Clip><RectangleGeometry Rect="0,0,350,149" RadiusX="20" RadiusY="20" /></Grid.Clip><Ellipse Width="190" Height="190" Fill="#4D694D" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-40,-65" />
                <StackPanel Margin="20,18"><TextBlock Text="A LITTLE, EVERY DAY" Foreground="#C8D7B6" FontSize="9" FontFamily="Georgia" /><TextBlock Text="把空隙，&#x0a;变成记忆。" FontSize="25" Foreground="#FFFCF0" FontWeight="SemiBold" LineHeight="34" Margin="0,10,0,0" /></StackPanel>
                <local:SpriteControl Width="88" Height="95" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,14,8" />
              </Grid>
            </Border>
            <Grid Margin="1,22,1,9"><TextBlock Text="墨墨学习进度" FontSize="12" Foreground="#647455" /><TextBlock x:Name="HomeProgress" Text="—" HorizontalAlignment="Right" FontSize="17" FontFamily="Georgia" Foreground="#3F5537" /></Grid>
            <ProgressBar x:Name="HomeProgressBar" Height="5" Minimum="0" Maximum="100" Foreground="#799563" Background="#E7EBD9" BorderThickness="0" />
            <TextBlock Text="词书与每日计划，继续沿用墨墨的设置。" Foreground="#737C69" FontSize="10" Margin="0,8,0,0" />
            <TextBlock Text="给这一小段时间，选个节奏" FontSize="13" Foreground="#526348" Margin="0,25,0,12" />
            <UniformGrid Columns="3">
              <RadioButton x:Name="ThreeMode" GroupName="Mode" Tag="3" Style="{StaticResource Mode}" Margin="0,0,4,0" IsChecked="True" Click="ChooseMode"><StackPanel><TextBlock Text="随手 3 词" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" /><TextBlock Text="等一会儿也能背" FontSize="9" Foreground="#6F7E5E" Margin="0,6,0,0" /></StackPanel></RadioButton>
              <RadioButton x:Name="FiveMode" GroupName="Mode" Tag="5" Style="{StaticResource Mode}" Margin="3,0" Click="ChooseMode"><StackPanel><TextBlock Text="专注 5 词" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" /><TextBlock Text="给记忆一点时间" FontSize="9" Foreground="#6F7E5E" Margin="0,6,0,0" /></StackPanel></RadioButton>
              <RadioButton x:Name="FreeMode" GroupName="Mode" Tag="0" Style="{StaticResource Mode}" Margin="4,0,0,0" Click="ChooseMode"><StackPanel><TextBlock Text="自由背" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" /><TextBlock Text="跟着自己的节奏" FontSize="9" Foreground="#6F7E5E" Margin="0,6,0,0" /></StackPanel></RadioButton>
            </UniformGrid>
            <Button x:Name="StartButton" Content="就背 3 个，开始吧  →" Height="46" Margin="0,20,0,0" Background="#405F43" Foreground="#FFFEF7" Click="StartStudy" />
            <TextBlock Text="完成一小组就休息，随时可以收起。" FontSize="11" Foreground="#737C69" HorizontalAlignment="Center" Margin="0,13,0,0" />
          </StackPanel>
        </ScrollViewer>
        <Grid x:Name="StudyPage" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <Grid><TextBlock x:Name="SessionText" Text="随手 3 词" FontSize="11" Foreground="#71835D" /><TextBlock x:Name="StudyProgress" HorizontalAlignment="Right" FontSize="11" Foreground="#71835D" /></Grid>
          <ScrollViewer x:Name="StudyScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,15,0,15">
            <StackPanel>
              <TextBlock x:Name="WordText" FontFamily="Georgia" FontSize="35" Foreground="#2E4434" TextWrapping="Wrap" LineHeight="43" />
              <StackPanel x:Name="PhoneticRow" Orientation="Horizontal" Margin="0,6,0,0"><TextBlock x:Name="PhoneticText" Foreground="#737C69" MaxWidth="245" TextWrapping="Wrap" FontSize="12" VerticalAlignment="Center" /><Button x:Name="AudioButton" Width="30" Height="28" Style="{StaticResource IconButton}" Content="&#xE767;" Foreground="#698357" Click="Audio" ToolTip="听一遍发音" AutomationProperties.Name="听单词发音" Margin="7,0,0,0" /></StackPanel>
              <StackPanel x:Name="RecallPanel" Margin="0,30,0,13"><TextBlock Text="在心里，说出它的意思。" Foreground="#6C7B5E" FontSize="14" /><TextBlock Text="记忆正在回来，不用着急。" Foreground="#7C856F" FontSize="11" Margin="0,10,0,0" /></StackPanel>
              <StackPanel x:Name="AnswerPanel" Visibility="Collapsed" Margin="0,22,0,0">
                <Border Background="#EEF2E3" CornerRadius="14" Padding="14,13"><TextBlock x:Name="MeaningText" FontSize="14" LineHeight="24" Foreground="#3A5036" TextWrapping="Wrap" /></Border>
                <Button x:Name="DetailsButton" HorizontalAlignment="Left" Padding="0,10" Background="Transparent" FontSize="11" Foreground="#6B7D57" Click="ToggleDetails" />
                <StackPanel x:Name="ExamplePanel" Visibility="Collapsed" Margin="0,0,0,7" />
              </StackPanel>
              <StackPanel x:Name="SpellingPanel" Visibility="Collapsed" Margin="0,16,0,0"><TextBlock x:Name="SpellingHint" FontSize="11" Foreground="#7A826A" Margin="0,0,0,9" /><TextBox x:Name="SpellingInput" Style="{StaticResource Field}" MaxLength="120" FontFamily="Georgia" FontSize="19" AutomationProperties.Name="输入单词拼写" /></StackPanel>
            </StackPanel>
          </ScrollViewer>
          <StackPanel Grid.Row="2" Margin="0,0,0,3">
            <Button x:Name="RevealButton" Height="44" Background="#405F43" Foreground="#FFFEF7" Click="Reveal"><StackPanel Orientation="Horizontal"><TextBlock x:Name="RevealLabel" Text="看看释义" /><TextBlock Text="SPACE" FontSize="9" Opacity="0.7" Margin="13,3,0,0" /></StackPanel></Button>
            <Button x:Name="SpellButton" Height="44" Background="#405F43" Foreground="#FFFEF7" Click="Spell" Visibility="Collapsed" Margin="0,0,0,7" />
            <UniformGrid x:Name="FeedbackPanel" Columns="3" Visibility="Collapsed">
              <Button x:Name="FamiliarButton" Margin="0,0,4,0" Padding="3,12" Background="#DEEBCE" Click="Familiar"><StackPanel><TextBlock x:Name="FamiliarText" Text="认识" HorizontalAlignment="Center" /><TextBlock x:Name="FamiliarHint" FontSize="9" Foreground="#647957" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="88" Margin="0,5,0,0" /></StackPanel></Button>
              <Button x:Name="VagueButton" Margin="3,0" Padding="3,12" Background="#F2E7CE" Click="Vague"><StackPanel><TextBlock x:Name="VagueText" Text="模糊" HorizontalAlignment="Center" /><TextBlock x:Name="VagueHint" FontSize="9" Foreground="#807152" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="88" Margin="0,5,0,0" /></StackPanel></Button>
              <Button x:Name="ForgetButton" Margin="4,0,0,0" Padding="3,12" Background="#F2DFD3" Click="Forget"><StackPanel><TextBlock x:Name="ForgetText" Text="忘记" HorizontalAlignment="Center" /><TextBlock x:Name="ForgetHint" FontSize="9" Foreground="#886B58" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="88" Margin="0,5,0,0" /></StackPanel></Button>
            </UniformGrid>
          </StackPanel>
        </Grid>
        <ScrollViewer x:Name="CompletePage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="0,20,0,0"><local:SpriteControl x:Name="CompleteSprite" Width="102" Height="110" HorizontalAlignment="Center" />
            <TextBlock Text="这一小段，刚刚好。" Foreground="#2E4334" FontSize="25" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,19,0,12" />
            <TextBlock x:Name="CompleteDetail" Text="又给记忆，浇了一点水。" Foreground="#687A59" TextWrapping="Wrap" TextAlignment="Center" FontSize="13" LineHeight="23" />
            <Border Background="#EDF2E1" CornerRadius="14" Padding="14,12" Margin="0,24,0,20"><TextBlock x:Name="CompleteProgress" Foreground="#667C52" TextAlignment="Center" FontSize="12" TextWrapping="Wrap" /></Border>
            <Button x:Name="ContinueButton" Content="再来一小组" Height="43" Background="#405F43" Foreground="White" Click="ContinueStudy" />
            <ItemsControl x:Name="CompletionActions" Margin="0,7,0,0"><ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Label}" Tag="{Binding Id}" Margin="0,4" Click="ExtraAction" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            <Button Content="今天这一刻，先到这里" Background="Transparent" Foreground="#6E7E5E" Margin="0,8,0,0" Click="Collapse" />
          </StackPanel>
        </ScrollViewer>
        <Grid x:Name="DialogPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <StackPanel Margin="0,14,0,22"><TextBlock Text="继续之前，看一眼" Foreground="#2E4334" FontSize="23" FontWeight="SemiBold" /><TextBlock Text="来自墨墨学习服务的提示" Foreground="#748368" FontSize="11" Margin="0,10,0,0" /></StackPanel>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><TextBlock x:Name="DialogMessage" FontSize="14" Foreground="#526348" LineHeight="26" TextWrapping="Wrap" /></ScrollViewer>
          <StackPanel Grid.Row="2" Margin="0,17,0,0"><WrapPanel x:Name="OfficialTerms" Visibility="Collapsed" HorizontalAlignment="Center"><Button Content="墨墨服务条款" Background="Transparent" Foreground="#526A45" Click="OpenTerms" /><Button Content="隐私政策" Background="Transparent" Foreground="#526A45" Click="OpenPrivacy" /></WrapPanel><ItemsControl x:Name="DialogActions"><ItemsControl.ItemTemplate><DataTemplate><Button Tag="{Binding Id}" Margin="0,4" Background="#E5ECD9" Click="ExtraAction"><TextBlock Text="{Binding Label}" TextWrapping="Wrap" /></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><Button x:Name="DialogRetry" Content="重试连接" Background="#405F43" Foreground="White" Click="Reconnect" /></StackPanel>
        </Grid>
        <StackPanel x:Name="StatusPage" VerticalAlignment="Center" Margin="4,0"><local:SpriteControl Width="92" Height="100" HorizontalAlignment="Center" />
          <TextBlock x:Name="StatusTitle" Text="我们去把单词带回来" FontSize="22" Foreground="#2E4334" TextAlignment="Center" FontWeight="SemiBold" Margin="0,20,0,13" />
          <TextBlock x:Name="StatusMessage" Text="正在连接你的墨墨学习空间…" FontSize="12" Foreground="#737C69" TextWrapping="Wrap" TextAlignment="Center" LineHeight="23" />
          <ProgressBar x:Name="ConnectionProgress" Height="3" Width="100" IsIndeterminate="True" Foreground="#839E6C" Background="#E7EDDC" BorderThickness="0" Margin="0,23,0,0" />
          <Button x:Name="ReconnectButton" Content="重新连接" Background="#405F43" Foreground="White" Margin="0,24,0,0" Click="Reconnect" Visibility="Collapsed" />
          <Button Content="检查账号登录" Background="Transparent" Foreground="#526A45" Margin="0,7,0,0" Click="OpenAccount" />
        </StackPanel>
      </Grid>
      <TextBlock Grid.Row="2" x:Name="FooterText" Text="小小的坚持，也会生长。" Foreground="#76836A" FontSize="10" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" VerticalAlignment="Bottom" />
    </Grid>
  </Border>
</Window>
